# Copy to .env and fill in the keys. Every key is optional: without one the app
# runs in a reduced mode (see README, "Running without keys").

# --- Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# --- Pinecone (https://app.pinecone.io)
PINECONE_API_KEY=
PINECONE_INDEX=crestline-kb
PINECONE_REGION=us-east-1
RERANK_MODEL=bge-reranker-v2-m3
HYBRID_ALPHA=0.6

# --- LangSmith (https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=crestline-assistant

# --- MCP server (docker compose overrides this with the service name)
MCP_URL=http://localhost:8001/mcp

# --- Auth / limits
JWT_SECRET=change-me
# role -> [bucket capacity, tokens refilled per second]
RATE_LIMITS={"viewer": [10, 0.2], "analyst": [20, 0.5], "admin": [40, 1.0]}

# LangGraph: only deserialize plain types from the checkpoint store
LANGGRAPH_STRICT_MSGPACK=true
LOG_LEVEL=INFO
